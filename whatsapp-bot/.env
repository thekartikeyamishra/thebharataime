# TheBharatAI WhatsApp Bot — Environment Variables
# File: whatsapp-bot/.env.example
#
# INSTRUCTIONS:
#   1. cp whatsapp-bot/.env.example whatsapp-bot/.env
#   2. Fill in your real values below
#   3. NEVER commit whatsapp-bot/.env to git
#   4. Run: node bot.js
#
# ════════════════════════════════════════════════════════════════
# REQUIRED SETUP
# ════════════════════════════════════════════════════════════════

# Your WhatsApp Business phone number
# Format: country code + number, no spaces, no +, no dashes
# Example: +91-98765-43210 → 919876543210
# Example: +1-555-123-4567 → 15551234567
#
# This is the number you'll scan the QR code with.
# Use a dedicated SIM for production (not your personal number).
WA_BUSINESS_NUMBER=91XXXXXXXXXX

# Admin JID for bot error alerts and startup notifications
# Format: [number]@s.whatsapp.net  (same number or a different admin number)
# Leave blank to disable admin alerts
WA_ADMIN_JID=91XXXXXXXXXX@s.whatsapp.net

# ════════════════════════════════════════════════════════════════
# OPTIONAL CONFIGURATION
# ════════════════════════════════════════════════════════════════

# Where to store WhatsApp session files
# Default: ./auth_info (relative to whatsapp-bot/)
# IMPORTANT: This directory contains auth tokens — keep it secure and gitignored
BOT_SESSION_DIR=./auth_info

# Logging level: silent | error | warn | info | debug
# Use 'silent' in production, 'info' for debugging
BOT_LOG_LEVEL=silent

# Max messages a single user can send per hour before being rate-limited
# Default: 30
BOT_RATE_LIMIT_PER_HOUR=30

# ════════════════════════════════════════════════════════════════
# PRODUCTION: META CLOUD API (>1,000 users/day)
# ════════════════════════════════════════════════════════════════
# Upgrade from Baileys to Meta's official WhatsApp Cloud API
# when your user base grows beyond 1,000 conversations/day.
# These replace the QR-code approach with a persistent API key.
#
# WA_CLOUD_API_TOKEN=your_meta_cloud_api_token
# WA_PHONE_NUMBER_ID=your_waba_phone_number_id
# WA_WEBHOOK_VERIFY_TOKEN=your_random_webhook_secret

# ════════════════════════════════════════════════════════════════
# SECURITY NOTES
# ════════════════════════════════════════════════════════════════
# ✅ .env.example → safe to commit (no real values)
# ❌ .env         → NEVER commit (in .gitignore)
# ❌ auth_info/   → NEVER commit (contains WhatsApp session tokens)
# ❌ Never log WA_BUSINESS_NUMBER or WA_ADMIN_JID to console/files
