  "scripts": {
    "setup":       "npm install && node scripts/generate-assets.js && echo Setup complete. Run: npm run dev",
    "dev":         "npx live-server --port=3000 --host=localhost --open=/index.html --ignore=node_modules,scripts,.git,hi,mr,te,ta,whatsapp-bot",
    "start":       "npm run dev",
    "generate":    "node scripts/generate-assets.js",
    "build":       "node scripts/generate-assets.js && node scripts/generate-programmatic.js && node scripts/generate-sitemap-v2.js",
    "build:pages": "node scripts/generate-programmatic.js",
    "build:sitemap":"node scripts/generate-sitemap-v2.js",
    "validate":    "node scripts/validate.js",
    "bot":         "cd whatsapp-bot && node bot.js",
    "bot:install": "cd whatsapp-bot && npm install",
    "deploy:vercel":"npx vercel --prod",
    "deploy:netlify":"npx netlify deploy --prod --dir=.",
    "clean:pages": "rm -rf hi mr te ta"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "pngjs":       "^7.0.0"
  },
  "keywords": [
    "government-schemes", "india", "eligibility-checker", "pm-kisan",
    "ayushman-bharat", "bharat", "hindi", "vernacular", "free-tool",
